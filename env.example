# PostgreSQL (majburiy). Supabase ishlatsangiz: Project Settings > Database > Connection string
DATABASE_URL=postgres://user:password@localhost:5432/edufinduz
# Supabase kabi bulutli bazalar uchun true qiling
DATABASE_SSL=false
# Token imzosi uchun uzun tasodifiy qator (majburiy). Yaratish: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Shu email bilan ro'yxatdan o'tgan foydalanuvchi administrator bo'ladi
ADMIN_EMAIL=
PORT=3000
# AI yordamchi (ixtiyoriy). Kalit bo'lmasa AI "demo holat" xabarini qaytaradi.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
